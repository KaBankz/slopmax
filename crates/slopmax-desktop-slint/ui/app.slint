// The slopmax window and menu bar icon. Everything shown comes from
// slopmax-app's snapshot; every button calls one of its actions.

import { Button, LineEdit, ScrollView, ComboBox, Palette } from "std-widgets.slint";

// Tones, as slopmax-core names them.
export enum Tone { good, muted, accent, warn, bad }

export struct Gauge {
    present: bool,
    fraction: float,
    percent: string,
    resets: string,
    tone: Tone,
}

export struct Label {
    text: string,
    tone: Tone,
}

export struct Row {
    id: string,
    name: string,
    plan: string,
    five-hour: Gauge,
    week: Gauge,
    status: Label,
    notes: [Label],
    pinned: bool,
    disabled: bool,
}

export struct Group {
    title: string,
    subscription: bool,
    rows: [Row],
    pooled: bool,
    pool-accounts: int,
    pool-five-hour: Gauge,
    pool-week: Gauge,
}

export struct Agent {
    id: string,
    title: string,
    state: string,
    connected: bool,
}

global Colors {
    out property <color> good: #3fb27f;
    out property <color> warn: #d99a1e;
    out property <color> bad: #e05d5d;
    out property <color> accent: #db2777;
    out property <color> track: Palette.color-scheme == ColorScheme.dark ? #2a313c : #e6e9ef;
    out property <color> line: Palette.color-scheme == ColorScheme.dark ? #2a313c : #e3e7ee;
    out property <color> panel: Palette.color-scheme == ColorScheme.dark ? #161b22 : #ffffff;
    out property <color> dim: Palette.color-scheme == ColorScheme.dark ? #8a96a8 : #6a7586;

    public pure function of(tone: Tone) -> color {
        if tone == Tone.good { return Colors.good; }
        if tone == Tone.warn { return Colors.warn; }
        if tone == Tone.bad { return Colors.bad; }
        if tone == Tone.accent { return Colors.accent; }
        return Colors.dim;
    }
}

component Caption inherits Text {
    color: Colors.dim;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.6px;
}

component GaugeCell inherits HorizontalLayout {
    in property <Gauge> gauge;
    spacing: 8px;
    min-width: 190px;
    alignment: start;
    if !root.gauge.present: Text {
        text: "—";
        color: Colors.dim;
        vertical-alignment: center;
    }
    if root.gauge.present: Rectangle {
        width: 110px;
        height: 7px;
        y: (parent.height - self.height) / 2;
        border-radius: 3.5px;
        background: Colors.track;
        Rectangle {
            x: 0;
            width: parent.width * root.gauge.fraction;
            height: parent.height;
            border-radius: parent.border-radius;
            background: Colors.of(root.gauge.tone);
        }
    }
    if root.gauge.present: Text {
        text: root.gauge.percent;
        width: 38px;
        horizontal-alignment: right;
        vertical-alignment: center;
        font-size: 12px;
        color: Colors.of(root.gauge.tone);
    }
    if root.gauge.present: Text {
        text: root.gauge.resets;
        vertical-alignment: center;
        font-size: 11px;
        color: Colors.dim;
    }
}

component Section inherits Rectangle {
    in property <string> title;
    background: Colors.panel;
    border-radius: 10px;
    border-width: 1px;
    border-color: Colors.line;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        Caption { text: root.title; }
        @children
    }
}

export component AppWindow inherits Window {
    title: "slopmax";
    icon: @image-url("../../../assets/icon.svg");
    preferred-width: 1100px;
    preferred-height: 760px;
    min-width: 760px;
    min-height: 520px;
    background: Palette.background;

    in property <string> proxy-state;
    in property <bool> proxy-running;
    in property <string> address;
    in property <[Group]> groups;
    in property <bool> has-accounts;
    in property <[Agent]> agents;
    in property <string> service-state;
    in property <bool> can-install-service;
    in property <string> notice;
    in property <bool> notice-error;
    in property <bool> signing-in;
    in property <string> sign-in-title;
    in property <string> sign-in-detail;
    in property <string> sign-in-link;
    in property <string> sign-in-code;
    in property <string> sign-in-notes;

    callback sign-in(string);
    callback add-key(string, string);
    callback paste(string);
    callback cancel-sign-in();
    callback import();
    callback pin(string);
    callback unpin-all();
    callback set-disabled(string, bool);
    callback connect-agent(string);
    callback disconnect-agent(string);
    callback start-proxy();
    callback stop-proxy();
    callback install-service();
    callback refresh();
    callback open-dashboard();
    callback dismiss-notice();

    property <[string]> key-providers: ["anthropic", "openai", "xai"];
    property <int> key-provider: 0;

    VerticalLayout {
        // Header
        Rectangle {
            height: 56px;
            border-width: 0;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 12px;
                alignment: stretch;
                Image {
                    source: @image-url("../../../assets/icon.svg");
                    width: 26px;
                    height: 26px;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: "slopmax";
                    font-size: 18px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: root.proxy-running ? Colors.good : Colors.dim;
                    }
                }
                Text {
                    text: root.proxy-state;
                    color: Colors.dim;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Button {
                    text: root.proxy-running ? "Stop proxy" : "Start proxy";
                    clicked => {
                        if root.proxy-running { root.stop-proxy(); } else { root.start-proxy(); }
                    }
                }
                Button {
                    text: "Refresh usage";
                    enabled: root.proxy-running;
                    clicked => { root.refresh(); }
                }
                Button {
                    text: "Dashboard";
                    enabled: root.proxy-running;
                    clicked => { root.open-dashboard(); }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Colors.line;
            }
        }

        body := ScrollView {
            // As wide as the window, so nothing scrolls sideways.
            VerticalLayout {
                width: body.visible-width;
                padding: 20px;
                spacing: 16px;
                alignment: start;

                if root.notice != "": Rectangle {
                    border-radius: 8px;
                    background: root.notice-error ? Colors.bad.transparentize(0.85) : Colors.good.transparentize(0.85);
                    HorizontalLayout {
                        padding: 10px;
                        spacing: 10px;
                        Text {
                            text: root.notice;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Button {
                            text: "Dismiss";
                            clicked => { root.dismiss-notice(); }
                        }
                    }
                }

                if root.signing-in: Section {
                    title: root.sign-in-title;
                    Text {
                        text: root.sign-in-detail;
                        wrap: word-wrap;
                    }
                    if root.sign-in-code != "": Text {
                        text: root.sign-in-code;
                        font-size: 24px;
                        font-weight: 700;
                        letter-spacing: 2px;
                    }
                    if root.sign-in-link != "": LineEdit {
                        text: root.sign-in-link;
                        read-only: true;
                    }
                    if root.sign-in-code == "": HorizontalLayout {
                        spacing: 8px;
                        paste := LineEdit {
                            placeholder-text: "Browser on another machine? Paste the address it ended on";
                            horizontal-stretch: 1;
                            accepted => { root.paste(self.text); self.text = ""; }
                        }
                        Button {
                            text: "Use address";
                            clicked => { root.paste(paste.text); paste.text = ""; }
                        }
                    }
                    if root.sign-in-notes != "": Text {
                        text: root.sign-in-notes;
                        color: Colors.warn;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: start;
                        Button {
                            text: "Cancel";
                            clicked => { root.cancel-sign-in(); }
                        }
                    }
                }

                Section {
                    title: "ACCOUNTS";
                    if !root.has-accounts: Text {
                        text: "No accounts yet. Sign in below, or import the logins Claude Code, Codex, or CLIProxyAPI already have.";
                        color: Colors.dim;
                        wrap: word-wrap;
                    }
                    for group in root.groups: VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 12px;
                            Caption {
                                text: group.title;
                                width: 240px;
                            }
                            if group.subscription: Caption {
                                text: "5 HOURS";
                                width: 190px;
                            }
                            if group.subscription: Caption {
                                text: "WEEK";
                                width: 190px;
                            }
                            Caption {
                                text: "STATUS";
                                horizontal-stretch: 1;
                            }
                        }
                        for row in group.rows: Rectangle {
                            border-radius: 6px;
                            background: row-hover.has-hover ? Colors.track.transparentize(0.5) : transparent;
                            row-hover := TouchArea { }
                            HorizontalLayout {
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 12px;
                                VerticalLayout {
                                    width: 240px;
                                    alignment: center;
                                    Text {
                                        text: row.name;
                                        font-weight: 600;
                                        overflow: elide;
                                        color: row.disabled ? Colors.dim : Palette.foreground;
                                    }
                                    Text {
                                        text: row.plan;
                                        font-size: 11px;
                                        color: Colors.dim;
                                    }
                                }
                                if group.subscription: GaugeCell {
                                    width: 190px;
                                    gauge: row.five-hour;
                                }
                                if group.subscription: GaugeCell {
                                    width: 190px;
                                    gauge: row.week;
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: row.status.text;
                                        color: Colors.of(row.status.tone);
                                        overflow: elide;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        for note in row.notes: Text {
                                            text: note.text;
                                            font-size: 11px;
                                            color: Colors.of(note.tone);
                                            overflow: elide;
                                        }
                                    }
                                }
                                Button {
                                    text: row.pinned ? "Pinned" : "Use";
                                    enabled: !row.pinned && !row.disabled;
                                    clicked => { root.pin(row.id); }
                                }
                                Button {
                                    text: row.disabled ? "Enable" : "Disable";
                                    clicked => { root.set-disabled(row.id, !row.disabled); }
                                }
                            }
                        }
                        if group.pooled: Rectangle {
                            border-radius: 6px;
                            background: Colors.accent.transparentize(0.92);
                            HorizontalLayout {
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 12px;
                                VerticalLayout {
                                    width: 240px;
                                    alignment: center;
                                    Text {
                                        text: "pool";
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: group.pool-accounts + " accounts as one";
                                        font-size: 11px;
                                        color: Colors.dim;
                                    }
                                }
                                GaugeCell {
                                    width: 190px;
                                    gauge: group.pool-five-hour;
                                }
                                GaugeCell {
                                    width: 190px;
                                    gauge: group.pool-week;
                                }
                                Text {
                                    text: "what the agents see";
                                    color: Colors.dim;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Button {
                            text: "Sign in with Claude";
                            primary: true;
                            clicked => { root.sign-in("claude"); }
                        }
                        Button {
                            text: "Sign in with ChatGPT";
                            primary: true;
                            clicked => { root.sign-in("codex"); }
                        }
                        Button {
                            text: "Import logins";
                            clicked => { root.import(); }
                        }
                        Button {
                            text: "Let slopmax choose";
                            clicked => { root.unpin-all(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        ComboBox {
                            width: 140px;
                            model: ["Anthropic API", "OpenAI API", "xAI API"];
                            current-index <=> root.key-provider;
                        }
                        key := LineEdit {
                            placeholder-text: "API key";
                            input-type: password;
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "Add key";
                            enabled: key.text != "";
                            clicked => {
                                root.add-key(root.key-providers[root.key-provider], key.text);
                                key.text = "";
                            }
                        }
                    }
                }

                Section {
                    title: "AGENTS";
                    for agent in root.agents: HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: agent.title;
                            font-weight: 600;
                            width: 140px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: agent.state;
                            color: agent.connected ? Colors.good : Colors.dim;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Button {
                            text: agent.connected ? "Disconnect" : "Connect";
                            clicked => {
                                if agent.connected { root.disconnect-agent(agent.id); } else { root.connect-agent(agent.id); }
                            }
                        }
                    }
                }

                Section {
                    title: "BACKGROUND";
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: root.address;
                            font-weight: 600;
                            width: 220px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.service-state;
                            color: Colors.dim;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if root.can-install-service: Button {
                            text: "Start at login";
                            clicked => { root.install-service(); }
                        }
                    }
                }
            }
        }
    }
}

// The menu bar (or system tray) icon: each pool's use at a glance.
export component Tray inherits SystemTrayIcon {
    in property <string> line;
    icon: @image-url("../../../assets/tray.svg");
    tooltip: root.line;
    title: root.line;

    callback open-window();
    callback refresh();
    callback quit();

    Menu {
        MenuItem {
            title: root.line;
            enabled: false;
        }
        MenuSeparator { }
        MenuItem {
            title: "Open slopmax";
            activated => { root.open-window(); }
        }
        MenuItem {
            title: "Refresh usage";
            activated => { root.refresh(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Quit";
            activated => { root.quit(); }
        }
    }
}
