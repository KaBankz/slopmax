{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "composite": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "skipLibCheck": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "effect/FileSystem",
          "effect/Path",
          "effect/PlatformError",
          "effect/ByteSize",
          "effect/cli",
          "effect/http",
          "effect/http-api",
          "effect/encoding",
          "effect/process",
          "effect/reactivity",
          "effect/rpc",
          "effect/crypto",
          "effect/testing",
          "@effect/platform-bun",
          "@effect/platform-node",
          "@effect/atom-react"
        ],
        "diagnosticSeverity": {
          "unstableApiUsage": "message",
          "floatingEffect": "error"
        }
      }
    ]
  }
}
