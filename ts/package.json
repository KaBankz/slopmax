{
  "name": "slopmax-ts",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "typecheck": "bun check -b",
    "test": "bun test",
